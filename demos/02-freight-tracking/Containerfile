ARG BUILDPLATFORM
FROM --platform=$BUILDPLATFORM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /src
COPY pom.xml .
RUN mvn -B -DskipTests dependency:go-offline
COPY src ./src
COPY loadgen ./loadgen
RUN mvn -B -DskipTests package
RUN javac --release 25 -d /src/loadgen-classes loadgen/FreightTrafficSimulator.java

FROM eclipse-temurin:25-jre
ENV PORT=8080
ENV MALLOC_ARENA_MAX=2
ENV OTEL_ENABLED=false
ENV OTEL_SERVICE_NAME=shipment-tracking
ENV HOME=/tmp
ADD https://repo1.maven.org/maven2/io/opentelemetry/javaagent/opentelemetry-javaagent/2.33.1/opentelemetry-javaagent-2.33.1.jar /opt/otel/opentelemetry-javaagent.jar
COPY container/entrypoint.sh /entrypoint.sh
COPY --from=build /src/target/shipment-tracking.jar /opt/tracking/shipment-tracking.jar
COPY --from=build /src/loadgen-classes/ /opt/tracking/loadgen/
RUN chmod 755 /entrypoint.sh
USER 1001
WORKDIR /tmp
ENTRYPOINT ["/entrypoint.sh"]
